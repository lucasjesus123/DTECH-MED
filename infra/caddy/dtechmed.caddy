# =============================================================================
# DTECH MED — bloco de site para o Caddy de borda da VPS
# =============================================================================
# Esta VPS não tem nginx. Quem atende as portas 80 e 443 é o Caddy da gaveta
# PORTAL_ESTETICA, que funciona como portaria compartilhada da máquina.
#
# O Caddyfile dele termina com:
#
#     # gavetas extras (fora do git)
#     import /data/sites-extra/*.caddy
#
# Ou seja: existe um ponto de extensão declarado. Colocar um arquivo em
# /data/sites-extra/ acrescenta um site SEM editar uma linha sequer da
# configuração do vizinho. É a diferença entre pendurar um aviso no quadro e
# rabiscar por cima do aviso dos outros.
#
# Deliberadamente enxuto. Este arquivo é lido por um processo do qual dependem
# outros dois sistemas: se ele não subir, os três saem do ar juntos. Cada
# diretiva aqui precisa valer o risco que carrega — por isso não há registro em
# arquivo (um diretório ausente impediria a portaria de subir; o `docker logs`
# do contêiner já mostra tudo) e não há cabeçalho de segurança (eles vêm do
# `next.config`, e a CSP é montada por requisição com um nonce; repetir a
# política aqui criaria DUAS na mesma resposta, o navegador aplicaria a
# interseção, e a página quebraria sem nada estar errado em nenhum dos dois
# arquivos).
#
# Instalação (o passo 8 do DEPLOY.md detalha):
#   docker cp infra/caddy/dtechmed.caddy \
#     portal-da-estetica-web-1:/data/sites-extra/dtechmed.caddy
#
# Os domínios estão escritos abaixo, prontos. NÃO os edite pelo terminal com
# `sed`: alguns clientes de terminal e de chat convertem automaticamente
# qualquer texto começando com "www." num link markdown, com colchetes e
# parênteses em volta. Isso é sintaxe inválida do Caddy — e o Caddy em questão
# atende as portas 80 e 443 da máquina inteira, então uma configuração que ele
# não consiga carregar derruba os três sites juntos, incluindo os dois
# vizinhos. Aconteceu neste deploy, com um `sed` que parecia inofensivo.
# Edite este arquivo no repositório e traga por `git pull`.
#
# =============================================================================
# POR QUE SÃO DOIS BLOCOS, E NÃO UM COM TRÊS NOMES
# =============================================================================
# O endereço da empresa é o dtechmed.com.br, sem "www". Empresa brasileira,
# atendimento em Lajeado, cliente que procura no Google digita ".com.br".
#
# Mas o "www" também precisa abrir: muita gente ainda digita, e link antigo
# espalhado por aí carrega o prefixo. A tentação é servir o site nos dois — e é
# a solução óbvia e a errada. Para o buscador, endereço diferente é PÁGINA
# diferente até prova em contrário: duas cópias da mesma home competindo entre
# si, e a reputação que o site constrói dividida em vez de somada. É o que se
# chama de conteúdo duplicado, e o estrago é justamente aquele que ninguém
# percebe — o site funciona perfeitamente enquanto vai ficando para trás na
# busca.
#
# Então um endereço serve e o outro manda para ele, com um 301, que é o código
# que significa "mudou de casa, e é definitivo". O buscador transfere a
# reputação para o destino e passa a mostrar só ele. Para quem digita, não muda
# nada.
#
# O domínio .com foi considerado e ficou de fora, por decisão do dono. Se um dia
# entrar, o lugar dele é o segundo bloco, junto do "www" — e só DEPOIS de o DNS
# dele apontar para esta máquina. Nome escrito aqui sem DNS apontando para cá faz
# o Caddy tentar emitir certificado repetidamente para um endereço que nunca
# valida: barulho no log de uma peça compartilhada, e pedidos recusados que
# contam para o limite da Let's Encrypt.
# =============================================================================


# -----------------------------------------------------------------------------
# QUEM ATENDE DE VERDADE
# -----------------------------------------------------------------------------
# Um nome só.
#
# O endereço de ensaio (conexevolution.online) ficou aqui durante a virada, para
# ter um caminho funcionando enquanto o DNS do domínio novo propagava. Cumprida
# essa função, ele saiu — e sair é a parte que se esquece.
#
# Endereço de ensaio deixado no ar é uma porta a menos vigiada apontando para o
# mesmo sistema: o mesmo login, o mesmo painel, os mesmos dados de cliente, num
# nome que ninguém mais olha. E no dia em que o registro daquele domínio
# expirar, é uma porta que outra pessoa pode registrar e passar a controlar.
dtechmed.com.br {
	encode zstd gzip

	# Seis fotos de celular numa tacada. A aplicação limita 8 MB por foto.
	request_body {
		max_size 60MB
	}

	# `route` preserva a ordem escrita aqui dentro. Fora dele, o Caddy aplica
	# sua própria ordem de diretivas — e o `reverse_proxy` atenderia tudo antes
	# de o `respond` ser consultado, fazendo a regra abaixo virar letra morta
	# sem nenhum sinal de que não está valendo.
	route {
		# SEC-009 da auditoria: método incomum morre na portaria, antes de
		# virar erro na aplicação e ruído no log.
		@metodo_estranho not method GET HEAD POST PUT PATCH DELETE OPTIONS
		respond @metodo_estranho 405

		# 172.17.0.1 é o host visto de dentro do contêiner do Caddy, e 5400 é a
		# gaveta do DTECH MED. Escrever 127.0.0.1 apontaria o Caddy para ele
		# mesmo — erro clássico, cujo sintoma é um 502 sem explicação. É o mesmo
		# endereço que o bloco da MINHAMECANICA usa para chegar ao site dela.
		reverse_proxy 172.17.0.1:5400 {
			# A aplicação grava o IP na trilha de auditoria e o usa para segurar
			# tentativa de login. Sem este cabeçalho, todo acesso apareceria
			# vindo da ponte do Docker — e o limite por IP passaria a valer para
			# o mundo inteiro somado.
			#
			# Só o X-Real-IP. O X-Forwarded-Proto que estava aqui rendia um
			# aviso do próprio Caddy no `validate`: ele já repassa esse
			# cabeçalho por conta. Configuração redundante numa peça
			# compartilhada é ruído que, com o tempo, faz o aviso legítimo
			# passar despercebido.
			header_up X-Real-IP {remote_host}
		}
	}

	# A única coisa que tiramos da resposta é a assinatura do servidor.
	header {
		-Server
	}
}

# -----------------------------------------------------------------------------
# QUEM SÓ APONTA O CAMINHO
# -----------------------------------------------------------------------------
# Uma linha de resposta. Não passa pela aplicação: o Caddy responde o 301 ali
# mesmo, na portaria, sem gastar um pedido da gaveta.
#
# O `{uri}` carrega junto o caminho e a busca. Sem ele, alguém que recebeu por
# WhatsApp um link de ordem de serviço com o "www" na frente cairia na home e
# perderia a página — e o token na URL, que é o que abre o portal do cliente,
# iria embora com ele. Com o `{uri}`, o endereço inteiro atravessa.
#
# `permanent` é o 301. O 302 (temporário) parece mais prudente e é pior aqui:
# o buscador não transfere reputação num redirecionamento temporário, e o
# navegador não guarda — os dois ficam esperando o dia em que o endereço volta a
# responder sozinho, que não vai chegar.
www.dtechmed.com.br {
	redir https://dtechmed.com.br{uri} permanent

	header {
		-Server
	}
}
