# =============================================================================
# DTECH MED — bloco de site para o Caddy de borda da VPS
# =============================================================================
# Esta VPS não tem nginx. Quem atende as portas 80 e 443 é o Caddy da gaveta
# PORTAL_ESTETICA, que funciona como portaria compartilhada da máquina.
#
# O Caddyfile dele termina com:
#
#     # gavetas extras (fora do git)
#     import /data/sites-extra/*.caddy
#
# Ou seja: existe um ponto de extensão declarado. Colocar um arquivo em
# /data/sites-extra/ acrescenta um site SEM editar uma linha sequer da
# configuração do vizinho. É a diferença entre pendurar um aviso no quadro e
# rabiscar por cima do aviso dos outros.
#
# Deliberadamente enxuto. Este arquivo é lido por um processo do qual dependem
# outros dois sistemas: se ele não subir, os três saem do ar juntos. Cada
# diretiva aqui precisa valer o risco que carrega — por isso não há registro em
# arquivo (um diretório ausente impediria a portaria de subir; o `docker logs`
# do contêiner já mostra tudo) e não há cabeçalho de segurança (eles vêm do
# `next.config`, e a CSP é montada por requisição com um nonce; repetir a
# política aqui criaria DUAS na mesma resposta, o navegador aplicaria a
# interseção, e a página quebraria sem nada estar errado em nenhum dos dois
# arquivos).
#
# Instalação (o passo 8 do DEPLOY.md detalha):
#   docker cp infra/caddy/dtechmed.caddy \
#     portal-da-estetica-web-1:/data/sites-extra/dtechmed.caddy
#
# ANTES DE INSTALAR, troque SEU_DOMINIO pelo endereço real.
# Durante o ensaio: conexevolution.online, www.conexevolution.online
# Na virada:        dtechmed.com.br, www.dtechmed.com.br
# =============================================================================

SEU_DOMINIO {
	encode zstd gzip

	# Seis fotos de celular numa tacada. A aplicação limita 8 MB por foto.
	request_body {
		max_size 60MB
	}

	# `route` preserva a ordem escrita aqui dentro. Fora dele, o Caddy aplica
	# sua própria ordem de diretivas — e o `reverse_proxy` atenderia tudo antes
	# de o `respond` ser consultado, fazendo a regra abaixo virar letra morta
	# sem nenhum sinal de que não está valendo.
	route {
		# SEC-009 da auditoria: método incomum morre na portaria, antes de
		# virar erro na aplicação e ruído no log.
		@metodo_estranho not method GET HEAD POST PUT PATCH DELETE OPTIONS
		respond @metodo_estranho 405

		# 172.17.0.1 é o host visto de dentro do contêiner do Caddy, e 5400 é a
		# gaveta do DTECH MED. Escrever 127.0.0.1 apontaria o Caddy para ele
		# mesmo — erro clássico, cujo sintoma é um 502 sem explicação. É o mesmo
		# endereço que o bloco da MINHAMECANICA usa para chegar ao site dela.
		reverse_proxy 172.17.0.1:5400 {
			# A aplicação grava o IP na trilha de auditoria e o usa para segurar
			# tentativa de login. Sem estes cabeçalhos, todo acesso apareceria
			# vindo da ponte do Docker — e o limite por IP passaria a valer para
			# o mundo inteiro somado.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# A única coisa que tiramos da resposta é a assinatura do servidor.
	header {
		-Server
	}
}
