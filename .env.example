# =============================================================================
# DTECH MED — Exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env real.
# Gere segredos com:  openssl rand -base64 48
# =============================================================================

# ---------- Aplicação ----------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="DTECH MED"

# ---------- Banco de dados ----------
# Usuário de aplicação: SEM privilégio de superusuário e SEM BYPASSRLS.
DATABASE_URL="postgresql://dtechmed_app:TROQUE_ESTA_SENHA@localhost:5432/dtechmed?schema=public&connection_limit=20&pool_timeout=20"
# Usuário de migração: separado do runtime, com permissão de DDL.
DIRECT_DATABASE_URL="postgresql://dtechmed_owner:TROQUE_ESTA_SENHA@localhost:5432/dtechmed?schema=public"

# ---------- Segredos de sessão e criptografia ----------
# 32 bytes em base64. Assina os cookies de sessão.
SESSION_SECRET=
# 32 bytes em base64. Criptografa segredos em repouso (ex.: token de instância uazapi).
ENCRYPTION_KEY=
# Sal do hash de documentos (CPF/CNPJ) para busca cega.
DOCUMENT_HASH_SALT=

# ---------- WhatsApp (uazapi) ----------
# Chave-mestra: controla TODAS as instâncias. Somente servidor. Nunca no frontend.
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=
# Segredo compartilhado que valida os webhooks recebidos da uazapi.
UAZAPI_WEBHOOK_SECRET=

# ---------- Armazenamento de arquivos ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Worker de automação ----------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=3000
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=6

# ---------- Segurança ----------
# Origens permitidas em produção, separadas por vírgula. Sem curinga.
ALLOWED_ORIGINS=http://localhost:3000
# Janela e teto do rate limit de login.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
# Duração da sessão em horas.
SESSION_TTL_HOURS=12
# Confia no header X-Forwarded-For (ative apenas atrás de proxy reverso confiável).
TRUST_PROXY=false

# ---------- Semeadura inicial ----------
# Usado uma única vez pelo `npm run db:seed` para criar o Super Admin.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
