// =============================================================================
// DTECH MED — Núcleo de dados
// =============================================================================
// Regra que organiza TUDO neste schema:
//
//   A Ordem é a espinha dorsal. Ela nasce quando o cliente pede socorro e só
//   morre quando o equipamento volta assinado na mão dele. Orçamento, fotos,
//   peças, pagamento e entrega NÃO são ilhas: são fatos pendurados na Ordem.
//   Por isso quase toda tabela aponta para `ordemId` — é o fio que costura.
//
//   Segunda regra: `tenantId` em toda tabela de negócio, sem exceção, com
//   Row Level Security no Postgres por cima (ver prisma/rls.sql). Duas camadas
//   independentes — se o código falhar, o banco ainda barra.
// =============================================================================

// Prisma 7: a URL de conexão vive em prisma.config.ts, e o cliente recebe um
// driver adapter (node-postgres). Isso não é formalidade — é o que nos dá
// controle direto do pool, necessário para aplicar `SET LOCAL app.tenant_id`
// na mesma conexão da transação e fazer o RLS valer de verdade.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS — o vocabulário do domínio
// =============================================================================

/// Papéis em ordem decrescente de poder.
/// SUPER_ADMIN é o único sem tenantId: ele cadastra as empresas (franquias).
enum Papel {
  SUPER_ADMIN // Dono da plataforma. Cria empresas e o admin de cada uma.
  ADMIN_EMPRESA // Responsável pela empresa. Cria os demais usuários.
  GESTOR // Aprova orçamento, aprova serviço, dá baixa financeira.
  ATENDENTE // Central: cadastra cliente, gera ordem de retirada, agenda.
  TECNICO // App do técnico: recebe, fotografa, lauda, executa, finaliza.
  MOTORISTA // App do motorista: retira e entrega, coleta assinatura.
  FINANCEIRO // Lança pagamentos e fecha faturas.
}

/// As etapas da linha do tempo, na ordem em que acontecem.
/// O motor (src/server/ordem/maquina-estados.ts) é quem autoriza cada salto.
enum EtapaOrdem {
  SOLICITACAO_RECEBIDA //  1. Cliente contatou pelo site ou WhatsApp
  ORDEM_RETIRADA_GERADA //  2. Central gerou a ordem de retirada
  RETIRADA_AGENDADA //  3. Retirada marcada com data, hora e motorista
  EM_ROTA_RETIRADA //  4. Motorista saiu para buscar
  COLETADO //  5. Assinado pelo cliente. Equipamento a caminho
  RECEBIDO_NA_EMPRESA //  6. Técnico deu entrada com as fotos
  EM_ANALISE //  7. Técnico diagnostica e monta o parecer
  ORCAMENTO_INTERNO //  8. Gestora revisa e fecha o orçamento
  ORCAMENTO_ENVIADO //  9. Orçamento no WhatsApp do cliente
  ORCAMENTO_APROVADO // 10. Cliente assinou. Virou contrato e gerou O.S.
  ORCAMENTO_REPROVADO //     Ramo alternativo: cliente recusou
  EM_MANUTENCAO // 11. Serviço em execução
  MANUTENCAO_CONCLUIDA // 12. Testes finais aprovados pelo técnico
  APROVACAO_GESTAO // 13. Gestão confere e libera para faturar
  FATURAMENTO // 14. Financeiro montando a cobrança
  FATURADO // 15. Pago. Liberado para entrega
  EM_ROTA_ENTREGA // 16. Motorista levando de volta
  ENTREGUE // 17. Assinado na porta do cliente
  FINALIZADO // 18. Gestor deu a baixa final
  DEVOLVIDO_SEM_REPARO //     Ramo alternativo: volta sem conserto
  CANCELADO //     Ramo alternativo: encerrada antes do fim
}

enum TipoPessoa {
  PF
  PJ
}

enum StatusOrcamento {
  RASCUNHO // Técnico ainda montando
  EM_REVISAO // Na mesa da gestora
  ENVIADO // No WhatsApp do cliente, aguardando decisão
  APROVADO // Assinado pelo cliente
  REPROVADO // Recusado
  EXPIRADO // Passou da validade sem resposta
  CANCELADO
}

enum TipoItemOrcamento {
  PECA
  SERVICO
  DESLOCAMENTO
  TAXA
}

enum TipoMovimentoEstoque {
  ENTRADA // Compra ou devolução ao estoque
  SAIDA // Consumo em uma O.S.
  AJUSTE // Correção de inventário
  RESERVA // Separada para uma O.S. aprovada, ainda não consumida
  LIBERACAO // Reserva desfeita (orçamento reprovado/cancelado)
  PERDA // Quebra, extravio
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  CHEQUE
}

enum StatusFatura {
  ABERTA // Emitida, nada recebido
  PARCIAL // Recebida em parte — o caso do pagamento fracionado
  QUITADA // Valor fechado
  CANCELADA
}

enum TipoAgendamento {
  RETIRADA
  ENTREGA
}

enum StatusAgendamento {
  PENDENTE
  ATRIBUIDO
  EM_ROTA
  CONCLUIDO
  FALHOU // Cliente ausente, endereço errado
  CANCELADO
}

enum TipoAssinatura {
  RETIRADA // Cliente entrega o equipamento ao motorista
  APROVACAO_ORCAMENTO // Cliente aceita o orçamento — vira contrato
  ENTREGA // Cliente recebe de volta
}

enum CategoriaFoto {
  RETIRADA // Estado em que SAIU da casa do cliente (até 6)
  RECEBIMENTO // Estado em que chegou (mínimo 6)
  ANALISE // Diagnóstico
  EXECUCAO // Durante o conserto
  PECA_SUBSTITUIDA // Peça velha retirada
  TESTE_FINAL // Funcionando
  ENTREGA // No ato da entrega
}

enum TipoDocumento {
  ORDEM_RETIRADA
  /// A mesma via, agora com a assinatura de quem entregou o aparelho. Tipo
  /// próprio porque é ela que vale como prova — e com o mesmo nome do primeiro
  /// as duas ficavam indistinguíveis na tela.
  COMPROVANTE_RETIRADA
  LAUDO_TECNICO
  ORCAMENTO
  CONTRATO_MANUTENCAO
  ORDEM_SERVICO
  RECIBO_PAGAMENTO
  COMPROVANTE_ENTREGA

  /// O contrato de PRESTAÇÃO de serviço, e não o de manutenção preventiva.
  ///
  /// `CONTRATO_MANUTENCAO` é o contrato do conserto daquela ordem, com as
  /// cláusulas de garantia. Este é o instrumento formal entre a empresa e o
  /// cliente, com as partes qualificadas, foro e prazo de pagamento — o
  /// documento que se pede quando o cliente é hospital ou órgão público e o
  /// setor de compras exige contrato assinado antes de liberar a nota.
  CONTRATO_PRESTACAO

  /// A nota promissória: promessa de pagamento com data e valor.
  ///
  /// Ela existe para o caso em que o cliente leva o aparelho e paga depois.
  /// Não é recibo (que prova o que JÁ foi pago) nem fatura (que é a cobrança):
  /// é um título, e o que o torna título é a assinatura do emitente sobre o
  /// valor por extenso.
  NOTA_PROMISSORIA
}

/// Para onde foi a peça que saiu do aparelho.
///
/// Existe porque o cliente às vezes PEDE a peça velha de volta — é a prova de
/// que o serviço foi feito — e porque componente de equipamento médico tem
/// descarte com regra. Sem registrar o destino, a discussão de dois meses
/// depois não tem resposta.
enum DestinoPeca {
  DEVOLVIDA_AO_CLIENTE /// Entregue junto com o aparelho
  GUARDADA /// Fica na assistência, à disposição
  DESCARTADA /// Descarte comum
  DESCARTE_CONTROLADO /// Bateria, placa, componente com regra própria
  RECICLADA /// Aproveitada em outro conserto
}

/// De quanto em quanto tempo a visita preventiva se repete.
enum Periodicidade {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum StatusVisita {
  PREVISTA /// Gerada pelo contrato, ainda sem data marcada
  AGENDADA /// Marcada na agenda, com técnico
  REALIZADA /// Feita — virou ordem de serviço
  CANCELADA
}

enum StatusJob {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
  DESCARTADO // Estourou as tentativas
}

enum StatusMensagem {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum StatusInstanciaWhats {
  DESCONECTADA
  CONECTANDO
  CONECTADA
  ERRO
}

enum OrigemLead {
  SITE
  WHATSAPP
  TELEFONE
  INDICACAO
  PRESENCIAL
  OUTRO
}

// =============================================================================
// PLATAFORMA — empresas (franquias) e usuários
// =============================================================================

/// Uma empresa = uma franquia = um tenant. A fronteira do isolamento.
model Tenant {
  id          String  @id @default(cuid())
  /// Subdomínio / identificador na URL. Ex.: "dtechmed-lajeado".
  slug        String  @unique
  nome        String
  razaoSocial String?
  cnpj        String? @unique
  /// Contato público exibido em documentos e mensagens.
  email       String?
  telefone    String?
  whatsapp    String?

  // Endereço da matriz — entra no cabeçalho dos PDFs.
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  /// Identidade visual da franquia nos documentos e no portal do cliente.
  logoUrl       String?
  corPrimaria   String  @default("#4A0D8F")
  corSecundaria String  @default("#1B5CFF")

  ativo          Boolean @default(true)
  plano          String  @default("padrao")
  /// Bloqueio administrativo pelo Super Admin (inadimplência, suspensão).
  bloqueado      Boolean @default(false)
  motivoBloqueio String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios            User[]
  clientes            Cliente[]
  equipamentos        Equipamento[]
  ordens              Ordem[]
  eventos             EventoOrdem[]
  fotos               Foto[]
  assinaturas         Assinatura[]
  orcamentos          Orcamento[]
  itensOrcamento      OrcamentoItem[]
  pecasRetiradas      PecaRetirada[]
  contratosManutencao ContratoManutencao[]
  visitasPreventivas  VisitaPreventiva[]
  pecas               Peca[]
  movimentos          MovimentoEstoque[]
  faturas             Fatura[]
  pagamentos          Pagamento[]
  agendamentos        Agendamento[]
  documentos          Documento[]
  leads               Lead[]
  jobs                OutboxJob[]
  mensagens           MensagemWhatsapp[]
  templates           TemplateMensagem[]
  instanciaWhats      WhatsappInstance?
  auditoria           AuditLog[]
  contadores          Contador[]
  posicoesRota        PosicaoRota[]
  recuperacoes        RecuperacaoSenha[]
  lancamentos         Lancamento[]
  recorrencias        Recorrencia[]
  compromissos        Compromisso[]
  modelosDocumento    ModeloDocumento[]

  @@index([ativo])
  @@map("tenants")
}

/// Usuário do sistema. `tenantId` nulo apenas para SUPER_ADMIN.
model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome      String
  email     String
  telefone  String?
  /// Argon2id. Nunca sai do servidor.
  senhaHash String
  papel     Papel

  ativo            Boolean   @default(true)
  /// Força troca de senha no primeiro acesso (usuário criado pelo admin).
  trocarSenha      Boolean   @default(true)
  ultimoLogin      DateTime?
  /// Contadores anti-força-bruta.
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?

  /// Avatar e assinatura digitalizada do técnico/motorista (usada nos laudos).
  avatarUrl String?

  /// As ABAS do sistema que esta pessoa vê.
  ///
  /// Vazio significa "o padrão do papel dela" — e é assim que nasce todo mundo,
  /// porque sistema em que cada acesso precisa ser montado do zero é sistema em
  /// que alguém esquece de marcar, e o esquecido vira a pessoa parada sem
  /// conseguir trabalhar no dia seguinte.
  ///
  /// A marcação SUBTRAI, nunca SOMA: cada aba tem um piso de papel, e marcar
  /// "Financeiro" para um motorista não faz ele ver o caixa. Sem essa regra, a
  /// hierarquia inteira cairia por uma caixinha — e caixinha é bem mais fácil
  /// de clicar por engano do que papel é de trocar. A regra vive em
  /// `src/server/auth/telas.ts`, num lugar só.
  telas String[]

  /// CPF de quem trabalha aqui. Entra em documento assinado — o termo de
  /// retirada leva o nome e o documento de quem recebeu o equipamento, e do
  /// nosso lado leva quem entregou.
  documento String?

  /// Endereço de quem trabalha aqui.
  ///
  /// Existe por dois motivos práticos: a ficha de funcionário que a empresa
  /// precisa ter, e a rota — o motorista que sai de casa direto para a
  /// primeira retirada não passa pela oficina, e o ponto de partida dele muda
  /// a ordem das paradas do dia.
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  criadoPorId  String?

  sessoes               Sessao[]
  eventos               EventoOrdem[]
  fotos                 Foto[]
  agendamentosMotorista Agendamento[]      @relation("MotoristaAgendamento")
  ordensTecnico         Ordem[]            @relation("TecnicoResponsavel")
  ordensAtendente       Ordem[]            @relation("AtendenteAbertura")
  orcamentosTecnico     Orcamento[]        @relation("TecnicoOrcamento")
  orcamentosRevisor     Orcamento[]        @relation("RevisorOrcamento")
  movimentos            MovimentoEstoque[]
  pagamentos            Pagamento[]
  compromissos          Compromisso[]      @relation("ResponsavelCompromisso")
  lancamentosAprovados  Lancamento[]       @relation("AprovadorLancamento")
  auditoria             AuditLog[]
  recuperacoes          RecuperacaoSenha[]

  /// E-mail é único DENTRO da empresa: o mesmo e-mail pode existir em duas
  /// franquias diferentes sem colidir.
  @@unique([tenantId, email])
  @@index([tenantId, papel, ativo])
  @@index([email])
  @@map("usuarios")
}

/// Sessão ativa. Guardamos só o hash do token — vazamento do banco não
/// entrega sessão utilizável.
model Sessao {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 do token que vai no cookie.
  tokenHash  String    @unique
  expiraEm   DateTime
  ip         String?
  userAgent  String?
  revogadaEm DateTime?
  criadoEm   DateTime  @default(now())
  ultimoUso  DateTime  @default(now())

  @@index([userId, expiraEm])
  @@index([expiraEm])
  @@map("sessoes")
}

// =============================================================================
// CADASTROS — cliente e equipamento
// =============================================================================

model Cliente {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tipo              TipoPessoa @default(PJ)
  nome              String
  razaoSocial       String?
  /// Só dígitos. É a chave que o cliente digita para abrir o orçamento.
  documento         String
  /// SHA-256(documento + sal) — permite conferir o CPF/CNPJ na aprovação
  /// sem comparar em texto claro e sem varrer a tabela.
  documentoHash     String
  inscricaoEstadual String?

  email    String?
  telefone String?
  /// Só dígitos com DDI. É para cá que a automação dispara.
  whatsapp String?

  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  uf              String?
  /// Referência para o motorista achar o lugar.
  pontoReferencia String?

  /// Nome de quem recebe o motorista na ponta.
  contatoNome     String?
  contatoTelefone String?

  /// ONDE O MOTORISTA VAI BUSCAR — que nem sempre é o endereço do cadastro.
  ///
  /// A clínica tem sede num lugar e sala de procedimento noutro; o hospital
  /// recebe pela doca dos fundos; o consultório manda buscar no galpão do
  /// sócio. Nesses casos o endereço de cima é onde a NOTA vai.
  ///
  /// Endereço errado aqui não é dado errado no banco: é o motorista
  /// atravessando a cidade e voltando de mãos vazias.
  ///
  /// A marca existe porque campo vazio é AMBÍGUO, e a ambiguidade cai em cima
  /// do motorista: ninguém sabe se vazio quer dizer "é o mesmo endereço" ou
  /// "ninguém perguntou ainda" — parecem iguais no banco e são opostos na rua.
  coletaMesmoEndereco Boolean @default(true)
  coletaCep           String?
  coletaLogradouro    String?
  coletaNumero        String?
  coletaComplemento   String?
  coletaBairro        String?
  coletaCidade        String?
  coletaUf            String?
  /// O que o motorista precisa saber antes de sair e não cabe em endereço:
  /// "só das 8h às 11h", "tocar no interfone 3", "entrar pela doca".
  coletaObservacao    String?

  /// QUEM RESPONDE PELO CLIENTE — diferente de `contatoNome`.
  ///
  /// `contatoNome` é quem atende o telefone. Representante é quem assina o
  /// contrato, autoriza o orçamento e aparece na nota promissória: o sócio na
  /// clínica, o comprador no hospital.
  ///
  /// Confundir os dois faz mandar o orçamento de oito mil para quem atende o
  /// telefone, e esperar aprovação de quem não pode dar.
  representanteNome     String?
  representanteTelefone String?
  representanteEmail    String?
  /// "sócio-proprietário", "gerente de compras", "responsável técnica".
  representanteVinculo  String?

  observacoes String?
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  equipamentos Equipamento[]
  ordens       Ordem[]
  faturas      Fatura[]

  /// Mesmo CNPJ pode ser cliente de duas franquias diferentes.
  contratos ContratoManutencao[]

  /// O que ele deve fora de uma ordem de serviço, e o que se repete todo mês.
  lancamentos  Lancamento[]
  recorrencias Recorrencia[]

  @@unique([tenantId, documento])
  @@index([tenantId, nome])
  @@index([tenantId, documentoHash])
  @@index([tenantId, ativo, criadoEm])
  @@map("clientes")
}

/// Multimarcas: `marca` é texto livre com catálogo de sugestão, nunca uma
/// lista fechada — a DTECH atende o que aparecer.
model Equipamento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  marca         String
  modelo        String
  /// Identidade física do aparelho. É o que amarra o histórico.
  numeroSerie   String?
  patrimonio    String?
  /// Ex.: laser, ultrassom, autoclave, cadeira odontológica, criolipólise.
  categoria     String?
  voltagem      String?
  anoFabricacao Int?
  /// Acessórios que vieram junto — evita briga na devolução.
  acessorios    String?
  observacoes   String?

  /// A foto de CATÁLOGO: ela identifica, não prova.
  ///
  /// As fotos de ordem provam o estado de um aparelho num momento e por isso
  /// são muitas, com categoria e autor. Esta responde uma pergunta só — "é
  /// esta?" — e por isso é uma, e mora na própria linha: uma tabela para
  /// guardar no máximo uma foto acrescentaria um JOIN em toda listagem para
  /// buscar um dado que cabe aqui.
  ///
  /// A miniatura é coluna própria, e não derivada por convenção de nome:
  /// convenção de nome quebra em silêncio, e um dia todas as miniaturas do
  /// sistema somem sem um erro sequer.
  fotoCaminho      String?
  fotoCaminhoThumb String?
  fotoHash         String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  ordens Ordem[]

  contratos ContratoManutencao[]

  @@index([tenantId, clienteId])
  @@index([tenantId, numeroSerie])
  @@index([tenantId, marca, modelo])
  @@map("equipamentos")
}

// =============================================================================
// A ESPINHA DORSAL — a Ordem e sua linha do tempo
// =============================================================================

model Ordem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Número sequencial por empresa. É o que o cliente cita no WhatsApp.
  numero Int

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  /// Onde o equipamento está AGORA na jornada.
  etapa EtapaOrdem @default(SOLICITACAO_RECEBIDA)

  /// Token opaco do portal público. O cliente acompanha a linha do tempo e
  /// aprova o orçamento por aqui, sem login — mas confirmando o documento.
  ///
  /// SEM valor padrão de propósito: a aplicação grava `novoToken()`, que são
  /// 256 bits de `randomBytes`. O `cuid()` do Prisma é cuid v1 — prefixo de
  /// relógio, contador sequencial, impressão digital da máquina e só 41 bits
  /// de aleatoriedade. Quem já recebeu um link conhece o relógio e o contador;
  /// sobrariam 41 bits para adivinhar a ordem do vizinho.
  tokenPublico String @unique

  /// Relato do cliente, em português dele.
  defeitoRelatado  String
  /// Diagnóstico do técnico.
  diagnostico      String?
  /// Parecer que a gestora lê antes de fechar o orçamento.
  parecerTecnico   String?
  /// O que foi efetivamente executado.
  servicoExecutado String?
  /// Resultado dos testes finais.
  testesFinais     String?

  /// ALTA para equipamento parado em clínica faturando.
  prioridade     String     @default("NORMAL")
  origem         OrigemLead @default(SITE)
  /// Quando 90% é retirada nossa, os 10% de correio precisam ser rastreáveis.
  viaCorreio     Boolean    @default(false)
  codigoRastreio String?

  atendenteId String?
  atendente   User?   @relation("AtendenteAbertura", fields: [atendenteId], references: [id], onDelete: SetNull)

  tecnicoId String?
  tecnico   User?   @relation("TecnicoResponsavel", fields: [tecnicoId], references: [id], onDelete: SetNull)

  /// Marcos temporais — alimentam os indicadores sem precisar varrer eventos.
  /// Quando a garantia deste serviço vence. Preenchida na ENTREGA — é dali que
  /// o prazo corre, e não da aprovação do orçamento.
  garantiaAte   DateTime?
  /// Esta ordem é retorno de garantia de um serviço anterior.
  emGarantia    Boolean   @default(false)
  /// O serviço que esta ordem está honrando, quando ele está no sistema.
  ordemOrigemId String?
  ordemOrigem   Ordem?    @relation("RetornoDeGarantia", fields: [ordemOrigemId], references: [id], onDelete: SetNull)
  retornos      Ordem[]   @relation("RetornoDeGarantia")

  /// Peças que saíram deste aparelho neste serviço.
  pecasRetiradas   PecaRetirada[]
  /// A visita preventiva que gerou esta ordem, quando veio de um contrato.
  visitaPreventiva VisitaPreventiva?

  abertaEm       DateTime  @default(now())
  coletadaEm     DateTime?
  recebidaEm     DateTime?
  orcadaEm       DateTime?
  aprovadaEm     DateTime?
  concluidaEm    DateTime?
  faturadaEm     DateTime?
  entregueEm     DateTime?
  finalizadaEm   DateTime?
  /// Prazo prometido ao cliente. Alimenta o alerta de atraso.
  prazoPrometido DateTime?

  atualizadoEm DateTime @updatedAt

  eventos      EventoOrdem[]
  fotos        Foto[]
  assinaturas  Assinatura[]
  orcamentos   Orcamento[]
  agendamentos Agendamento[]
  documentos   Documento[]
  movimentos   MovimentoEstoque[]
  fatura       Fatura?
  mensagens    MensagemWhatsapp[]

  @@unique([tenantId, numero])
  @@index([tenantId, etapa, abertaEm])
  @@index([tenantId, clienteId, abertaEm])
  @@index([tenantId, tecnicoId, etapa])
  @@index([tenantId, equipamentoId])
  /// "Este aparelho está na garantia?" — a pergunta que a ficha faz sempre.
  @@index([equipamentoId, garantiaAte])
  @@index([ordemOrigemId])
  @@index([tenantId, prazoPrometido])
  @@map("ordens")
}

/// Linha do tempo imutável. Cada registro é encadeado por hash ao anterior:
/// alterar ou apagar um evento quebra a cadeia e fica evidente no relatório.
/// É isto que responde "quem mexeu no quê" no fim do processo.
model EventoOrdem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  /// Ordem do evento dentro da Ordem. Começa em 1.
  sequencia Int

  etapaAnterior EtapaOrdem?
  etapaNova     EtapaOrdem

  /// Chave da automação. Ex.: "ordem.coletada", "orcamento.aprovado".
  tipo      String
  titulo    String
  descricao String?

  /// Autor congelado no momento do fato: se o usuário for renomeado ou
  /// desligado depois, o histórico continua contando a verdade da época.
  autorId    String?
  autor      User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome  String
  autorPapel Papel

  /// Dados extras do fato (coordenadas, valores, ids relacionados).
  payload Json?

  /// SHA-256(sequencia | ordemId | etapaNova | tipo | autorId | criadoEm | payload | hashAnterior)
  hash         String
  hashAnterior String?

  /// Marca o que o cliente enxerga no portal público.
  visivelCliente Boolean @default(true)

  ip       String?
  criadoEm DateTime @default(now())

  @@unique([ordemId, sequencia])
  @@index([tenantId, ordemId, sequencia])
  @@index([tenantId, tipo, criadoEm])
  @@index([tenantId, autorId, criadoEm])
  @@map("eventos_ordem")
}

/// Foto do equipamento. O app do técnico exige no mínimo 6 no recebimento.
model Foto {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  categoria    CategoriaFoto
  /// Caminho interno no storage. Nunca é URL pública — o download passa por
  /// rota autenticada que confere o tenant.
  caminho      String
  caminhoThumb String?
  legenda      String?
  larguraPx    Int?
  alturaPx     Int?
  tamanhoBytes Int?
  /// SHA-256 do arquivo: prova que a imagem não foi trocada depois.
  hashArquivo  String

  autorId   String?
  autor     User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String

  /// Onde a foto foi tirada, quando o aparelho informa.
  latitude  Float?
  longitude Float?

  criadoEm DateTime @default(now())

  @@index([tenantId, ordemId, categoria])
  @@index([tenantId, criadoEm])
  @@map("fotos")
}

/// Assinatura coletada na tela do celular ou no portal do cliente.
/// Guarda o contexto todo — é a prova de que o ato aconteceu.
model Assinatura {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  tipo TipoAssinatura

  assinanteNome      String
  /// Documento informado no ato — conferido contra o cadastro do cliente.
  assinanteDocumento String?
  /// PNG do traço, no storage.
  caminhoImagem      String
  hashImagem         String

  /// Prova de contexto: onde, quando, de qual aparelho.
  latitude           Float?
  longitude          Float?
  precisaoM          Float?
  enderecoAproximado String?
  ip                 String?
  userAgent          String?

  /// Hash do conteúdo do documento no instante da assinatura. Se o texto do
  /// contrato mudar depois, a divergência fica provável.
  hashDocumento String?

  criadoEm DateTime @default(now())

  @@index([tenantId, ordemId, tipo])
  @@map("assinaturas")
}

// =============================================================================
// ORÇAMENTO E CONTRATO
// =============================================================================

model Orcamento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  numero Int
  /// Reprovou e a gestora refez? Nova versão, histórico preservado.
  versao Int             @default(1)
  status StatusOrcamento @default(RASCUNHO)

  laudoTecnico      String?
  observacoes       String?
  /// Condições que viram cláusula do contrato de manutenção.
  garantiaDias      Int     @default(90)
  prazoExecucaoDias Int     @default(7)

  /// Valores em centavos. Dinheiro nunca em ponto flutuante.
  subtotalPecas     Int @default(0)
  subtotalServicos  Int @default(0)
  descontoCentavos  Int @default(0)
  acrescimoCentavos Int @default(0)
  totalCentavos     Int @default(0)

  validoAte DateTime?

  tecnicoId String?
  tecnico   User?   @relation("TecnicoOrcamento", fields: [tecnicoId], references: [id], onDelete: SetNull)
  revisorId String?
  revisor   User?   @relation("RevisorOrcamento", fields: [revisorId], references: [id], onDelete: SetNull)

  enviadoEm            DateTime?
  respondidoEm         DateTime?
  /// Quem clicou em aprovar, do lado do cliente.
  aprovadoPorNome      String?
  aprovadoPorDocumento String?
  motivoReprovacao     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itens OrcamentoItem[]

  @@unique([tenantId, numero, versao])
  @@index([tenantId, status, criadoEm])
  @@index([tenantId, ordemId])
  @@map("orcamentos")
}

model OrcamentoItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  tipo TipoItemOrcamento

  /// Quando é peça do estoque, aponta para ela — é assim que a aprovação do
  /// orçamento reserva o material automaticamente.
  pecaId String?
  peca   Peca?   @relation(fields: [pecaId], references: [id], onDelete: SetNull)

  descricao          String
  quantidade         Decimal @db.Decimal(12, 3)
  valorUnitCentavos  Int
  valorTotalCentavos Int

  ordem Int @default(0)

  @@index([tenantId, orcamentoId])
  @@index([tenantId, pecaId])
  @@map("orcamento_itens")
}

// =============================================================================
// ESTOQUE — integrado, nunca paralelo
// =============================================================================

/// A peça que SAIU do aparelho, e para onde ela foi.
///
/// Não é movimento de estoque: a peça retirada não volta para a prateleira, ela
/// sai do sistema. O que se guarda é o destino — porque o cliente às vezes pede
/// a peça velha de volta como prova do serviço, e porque componente de
/// equipamento médico tem regra de descarte.
model PecaRetirada {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  /// O que era, escrito pelo técnico. Nem toda peça que sai está no catálogo:
  /// a fonte queimada de um aparelho de 2011 não tem SKU aqui dentro.
  descricao     String
  destino       DestinoPeca
  /// Número de série ou lote da peça retirada, quando ela tem.
  identificacao String?
  observacao    String?

  registradoPorId   String?
  registradoPorNome String
  criadoEm          DateTime @default(now())

  @@index([tenantId, ordemId])
  @@map("pecas_retiradas")
}

/// Contrato de manutenção preventiva.
///
/// ---------------------------------------------------------------------------
/// POR QUE ISTO É O ITEM MAIS VALIOSO DO SISTEMA
/// ---------------------------------------------------------------------------
/// Uma assistência que só conserta o que quebra vive de sobressalto: o mês bom
/// depende de o cliente ter um problema. A revisão periódica inverte isso —
/// autoclave, laser e compressor precisam de revisão com hora marcada, e o
/// contrato transforma isso em receita que se sabe de antemão.
///
/// O desenho vem do Maintenance Schedule do ERPNext, traduzido: lá o contrato
/// gera "visitas"; aqui cada visita vira uma ORDEM DE SERVIÇO comum quando
/// chega a hora, porque é a esteira de 18 etapas que já sabe cobrar assinatura,
/// foto e laudo. Um caminho paralelo seria um segundo sistema dentro do
/// primeiro.
model ContratoManutencao {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  numero Int

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  /// O contrato cobre UM equipamento. Clínica com autoclave e laser assina
  /// dois: períodos, valores e técnicos são diferentes, e juntá-los num
  /// contrato só esconde qual dos dois está atrasado.
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  periodicidade Periodicidade
  inicio        DateTime
  /// Quando o contrato acaba. Nulo = corre até alguém encerrar.
  fim           DateTime?

  /// Valor de CADA visita. O total do contrato é isto vezes as visitas — e
  /// guardar o total em vez do unitário quebraria na primeira renovação.
  valorVisitaCentavos Int @default(0)

  ativo       Boolean   @default(true)
  encerradoEm DateTime?
  observacoes String?

  visitas VisitaPreventiva[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId, ativo])
  @@index([tenantId, equipamentoId])
  @@map("contratos_manutencao")
}

/// Cada revisão prevista pelo contrato.
model VisitaPreventiva {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contratoId String
  contrato   ContratoManutencao @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  /// A data que o contrato calculou. Fica mesmo depois de agendada, para dar
  /// para ver que a visita de março aconteceu em abril.
  previstaPara DateTime
  status       StatusVisita @default(PREVISTA)

  /// A ordem que a visita virou. É por ela que a preventiva entra na esteira
  /// normal, com assinatura, foto e laudo.
  ordemId String? @unique
  ordem   Ordem?  @relation(fields: [ordemId], references: [id], onDelete: SetNull)

  observacao String?
  criadoEm   DateTime @default(now())

  @@index([tenantId, status, previstaPara])
  @@index([contratoId, previstaPara])
  @@map("visitas_preventivas")
}

model Peca {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku       String
  nome      String
  descricao String?
  categoria String?
  marca     String?
  /// Compatibilidade: em quais equipamentos essa peça serve.
  aplicacao String?
  unidade   String  @default("UN")

  /// Centavos. `custoMedio` é recalculado a cada entrada (média ponderada).
  custoMedioCentavos Int @default(0)
  precoVendaCentavos Int @default(0)

  /// Saldo físico total.
  saldo          Decimal @default(0) @db.Decimal(12, 3)
  /// Parte do saldo já comprometida com O.S. aprovadas.
  saldoReservado Decimal @default(0) @db.Decimal(12, 3)
  estoqueMinimo  Decimal @default(0) @db.Decimal(12, 3)

  localizacao String?
  fornecedor  String?
  ativo       Boolean @default(true)

  /// A foto de CATÁLOGO: ela identifica, não prova.
  ///
  /// As fotos de ordem provam o estado de um aparelho num momento e por isso
  /// são muitas, com categoria e autor. Esta responde uma pergunta só — "é
  /// esta?" — e por isso é uma, e mora na própria linha: uma tabela para
  /// guardar no máximo uma foto acrescentaria um JOIN em toda listagem para
  /// buscar um dado que cabe aqui.
  ///
  /// A miniatura é coluna própria, e não derivada por convenção de nome:
  /// convenção de nome quebra em silêncio, e um dia todas as miniaturas do
  /// sistema somem sem um erro sequer.
  fotoCaminho      String?
  fotoCaminhoThumb String?
  fotoHash         String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  movimentos     MovimentoEstoque[]
  itensOrcamento OrcamentoItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, ativo, nome])
  @@index([tenantId, categoria])
  @@map("pecas")
}

/// Livro-razão do estoque: o saldo da peça é consequência destes movimentos,
/// nunca um número digitado à mão.
model MovimentoEstoque {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pecaId String
  peca   Peca   @relation(fields: [pecaId], references: [id], onDelete: Restrict)

  /// Presente quando o movimento nasceu de uma O.S. — o elo estoque↔ordem.
  ordemId String?
  ordem   Ordem?  @relation(fields: [ordemId], references: [id], onDelete: SetNull)

  tipo              TipoMovimentoEstoque
  quantidade        Decimal              @db.Decimal(12, 3)
  saldoAnterior     Decimal              @db.Decimal(12, 3)
  saldoPosterior    Decimal              @db.Decimal(12, 3)
  custoUnitCentavos Int                  @default(0)

  motivo          String?
  documentoFiscal String?

  autorId   String?
  autor     User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String

  criadoEm DateTime @default(now())

  @@index([tenantId, pecaId, criadoEm])
  @@index([tenantId, ordemId])
  @@index([tenantId, tipo, criadoEm])
  @@map("movimentos_estoque")
}

// =============================================================================
// FINANCEIRO — uma fatura, vários pagamentos
// =============================================================================

model Fatura {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Uma fatura por Ordem: a cobrança é do serviço daquele equipamento.
  ordemId String @unique
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  numero Int
  status StatusFatura @default(ABERTA)

  /// Centavos. `valorPago` é a soma dos pagamentos; o aberto é derivado.
  valorTotalCentavos Int
  valorPagoCentavos  Int @default(0)
  descontoCentavos   Int @default(0)

  /// Encargos em colunas próprias, nunca embutidos no valor pago — sem isso
  /// não há como responder "quanto entrou de juros no mês" nem conciliar com
  /// o extrato da maquininha.
  /// multa/juros somam ao que o cliente deve; taxa é custo nosso.
  /// Recebido líquido = valorPago − taxa.
  multaCentavos Int @default(0)
  jurosCentavos Int @default(0)
  taxaCentavos  Int @default(0)

  vencimento DateTime?
  emitidaEm  DateTime  @default(now())
  quitadaEm  DateTime?

  /// "Pago" é operacional: alguém registrou a entrada.
  /// "Conferido" é gerencial: o gestor olhou e validou. São camadas distintas —
  /// misturá-las tira do dono a única checagem que ele de fato controla.
  /// Esta é a etapa 16: a baixa final do gestor.
  conferido        Boolean   @default(false)
  conferidoPorId   String?
  conferidoPorNome String?
  conferidoEm      DateTime?

  observacoes String?

  pagamentos Pagamento[]

  @@unique([tenantId, numero])
  @@index([tenantId, status, vencimento])
  @@index([tenantId, clienteId])
  @@index([tenantId, conferido, quitadaEm])
  @@map("faturas")
}

/// Pagamento fracionado: o cliente pode quitar em dinheiro + pix + cartão.
/// Cada linha é um recebimento; a fatura fecha quando a soma bate no total.
model Pagamento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  forma              FormaPagamento
  valorCentavos      Int
  /// Cartão parcelado: quantas vezes.
  parcelas           Int            @default(1)
  bandeira           String?
  /// NSU / código de autorização da maquininha, ou e2e do Pix.
  autorizacao        String?
  observacao         String?
  comprovanteCaminho String?

  recebidoEm    DateTime  @default(now())
  /// Estorno mantém a linha e marca o cancelamento — nada some do caixa.
  estornadoEm   DateTime?
  motivoEstorno String?

  autorId   String?
  autor     User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String

  criadoEm DateTime @default(now())

  @@index([tenantId, faturaId])
  @@index([tenantId, recebidoEm])
  @@index([tenantId, forma, recebidoEm])
  @@map("pagamentos")
}

// =============================================================================
// LOGÍSTICA — retirada e entrega
// =============================================================================

model Agendamento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  tipo   TipoAgendamento
  status StatusAgendamento @default(PENDENTE)

  motoristaId String?
  motorista   User?   @relation("MotoristaAgendamento", fields: [motoristaId], references: [id], onDelete: SetNull)

  previstoPara DateTime
  /// Janela combinada com o cliente ("entre 14h e 17h").
  janelaInicio DateTime?
  janelaFim    DateTime?

  iniciadoEm  DateTime?
  concluidoEm DateTime?

  /// Endereço congelado no agendamento: se o cadastro do cliente mudar depois,
  /// o comprovante continua mostrando onde o motorista realmente foi.
  enderecoSnapshot String
  contatoNome      String?
  contatoTelefone  String?
  pontoReferencia  String?

  /// Posição na rota do dia daquele motorista.
  posicaoRota Int?
  observacoes String?
  motivoFalha String?

  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  posicoes     PosicaoRota[]

  @@index([tenantId, motoristaId, previstoPara])
  @@index([tenantId, status, previstoPara])
  @@index([tenantId, ordemId, tipo])
  @@map("agendamentos")
}

// =============================================================================
// DOCUMENTOS, AUTOMAÇÃO E COMUNICAÇÃO
// =============================================================================

/// PDF gerado pelo sistema. Fica disponível no ato, tanto no painel quanto
/// no WhatsApp do cliente.
model Documento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String
  ordem   Ordem  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  tipo         TipoDocumento
  numero       String
  caminho      String
  hash         String
  tamanhoBytes Int?

  /// Token para o link do WhatsApp funcionar sem login. Pelo mesmo motivo do
  /// `tokenPublico` da Ordem, vem de `novoToken()` e não de `cuid()`.
  tokenAcesso String @unique

  geradoEm DateTime @default(now())

  @@index([tenantId, ordemId, tipo])
  @@map("documentos")
}

/// Fila transacional. O job é gravado na MESMA transação que muda a etapa da
/// Ordem: ou os dois acontecem, ou nenhum. É o que impede "mudou de etapa mas
/// o cliente não foi avisado".
model OutboxJob {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Ex.: "whatsapp.enviar", "pdf.gerar", "orcamento.expirar".
  tipo    String
  payload Json
  status  StatusJob @default(PENDENTE)

  prioridade    Int      @default(5)
  tentativas    Int      @default(0)
  maxTentativas Int      @default(6)
  /// Backoff exponencial: o worker só pega o job quando chega a hora.
  agendadoPara  DateTime @default(now())
  ultimoErro    String?

  /// Chave de idempotência: impede disparo duplicado do mesmo aviso.
  dedupeKey String? @unique

  /// Trava otimista para dois workers não pegarem o mesmo job.
  travadoPor String?
  travadoEm  DateTime?

  criadoEm     DateTime  @default(now())
  processadoEm DateTime?

  @@index([status, agendadoPara, prioridade])
  @@index([tenantId, tipo, criadoEm])
  @@map("outbox_jobs")
}

/// Registro de tudo que saiu no WhatsApp. Auditoria e reenvio.
model MensagemWhatsapp {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ordemId String?
  ordem   Ordem?  @relation(fields: [ordemId], references: [id], onDelete: SetNull)

  numero       String
  /// Chave do template usado. Ex.: "ordem.coletada".
  template     String?
  corpo        String
  midiaCaminho String?

  status     StatusMensagem @default(PENDENTE)
  /// id devolvido pela uazapi, no formato owner:messageid.
  providerId String?
  erro       String?

  enviadaEm  DateTime?
  entregueEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([tenantId, ordemId])
  @@index([tenantId, status, criadoEm])
  @@index([providerId])
  @@map("mensagens_whatsapp")
}

/// Texto que o cliente recebe em cada etapa. Editável por empresa — cada
/// franquia fala do seu jeito, com as mesmas variáveis.
model TemplateMensagem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Casa com `EventoOrdem.tipo`. Ex.: "ordem.coletada".
  chave           String
  titulo          String
  /// Suporta {{cliente}}, {{equipamento}}, {{numero}}, {{motorista}}, ...
  corpo           String
  /// Anexa o PDF daquela etapa junto da mensagem.
  anexarDocumento Boolean @default(false)
  ativo           Boolean @default(true)

  atualizadoEm DateTime @updatedAt

  @@unique([tenantId, chave])
  @@map("templates_mensagem")
}

/// Instância uazapi da empresa. Um número de WhatsApp por franquia.
model WhatsappInstance {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  uazInstanceId   String?
  /// Cifrado em repouso com ENCRYPTION_KEY (AES-256-GCM). Nunca vai ao browser.
  uazTokenCifrado String?

  status      StatusInstanciaWhats @default(DESCONECTADA)
  numero      String?
  profileName String?

  ultimoStatusEm DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@map("whatsapp_instances")
}

/// Contato que chegou pelo site antes de virar cliente.
model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome        String
  telefone    String
  email       String?
  empresa     String?
  cidade      String?
  equipamento String?
  mensagem    String?
  origem      OrigemLead @default(SITE)

  /// novo | em_contato | convertido | descartado
  status        String  @default("novo")
  /// Preenchido quando o lead vira Ordem — fecha o ciclo site → sistema.
  ordemGeradaId String?

  ip        String?
  userAgent String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tenantId, status, criadoEm])
  @@map("leads")
}

// =============================================================================
// AUDITORIA E INFRAESTRUTURA
// =============================================================================

/// Trilha de segurança (login, permissão negada, exclusão, exportação).
/// Complementa EventoOrdem, que é a trilha de negócio.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Congelado: continua legível se o usuário for removido.
  userNome  String?
  userPapel Papel?

  acao       String
  entidade   String?
  entidadeId String?
  /// Nunca guardamos senha, token ou documento em claro aqui.
  detalhes   Json?

  ip        String?
  userAgent String?
  /// Marca tentativa barrada — o sinal de alarme de multi-tenant.
  negado    Boolean @default(false)

  criadoEm DateTime @default(now())

  @@index([tenantId, criadoEm])
  @@index([userId, criadoEm])
  @@index([acao, criadoEm])
  @@index([negado, criadoEm])
  @@map("audit_logs")
}

/// Pagar ou receber. As duas metades do caixa.
enum TipoLancamento {
  PAGAR
  RECEBER
}

/// O dinheiro que NÃO nasce de uma ordem de serviço.
///
/// `faturas` é um para um com `ordens`, porque a cobrança é do reparo daquele
/// equipamento. Isso responde "quanto o cliente me deve" e não responde nada
/// sobre a empresa: aluguel, energia, contador, salário, a peça comprada no
/// fornecedor, o recebimento avulso que não passou pela esteira.
///
/// São dois conceitos com ciclos de vida diferentes — a fatura nasce da esteira
/// e morre conferida pela gestão; o lançamento nasce à mão ou de uma recorrência
/// e morre pago. A TELA junta os dois; o BANCO os mantém separados.
///
/// PARCELAS SÃO LINHAS. Uma compra em 3x vira três registros com vencimentos
/// diferentes, ligados por `grupo` — não uma linha com "parcelas = 3". O motivo
/// é o mês: a segunda parcela vence em setembro e tem de aparecer no caixa de
/// setembro. Uma linha só não consegue estar em três meses ao mesmo tempo.
model Lancamento {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo     TipoLancamento

  descricao String
  /// Texto livre com sugestões na tela, nunca lista fechada: cada empresa
  /// organiza o próprio plano de contas, e lista fixa vira "Outros" com 80%
  /// dos lançamentos dentro.
  categoria String?

  /// Quem paga ou recebe. `clienteId` quando já está na carteira — assim a
  /// ficha do cliente consegue somar o que ele deve. `contraparte` é o texto
  /// para o resto: fornecedor, prefeitura, o contador.
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  contraparte String?

  valorCentavos Int
  vencimento    DateTime

  /// A baixa. `pagoEm` nulo = em aberto. O valor pago fica separado do previsto
  /// porque eles divergem: desconto, juros, pagamento a menor.
  pagoEm            DateTime?
  valorPagoCentavos Int             @default(0)
  forma             FormaPagamento?

  grupo    String?
  parcela  Int     @default(1)
  parcelas Int     @default(1)

  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  observacoes String?

  autorId   String?
  autorNome String?

  /// A APROVAÇÃO — quem lança não é quem aprova.
  ///
  /// Sem ela, uma conta a pagar inventada percorre o sistema inteiro sem passar
  /// por outro par de olhos e some no meio de duzentas verdadeiras. O que exige
  /// aprovação é a BAIXA, não o lançamento: é na baixa que o dinheiro sai.
  ///
  /// Três colunas e não um booleano: `aprovado = true` responde "está
  /// aprovado?" e emudece na pergunta que sempre vem depois — "quem liberou, e
  /// quando?". O nome vai junto porque o id some se a pessoa deixar a empresa.
  aprovadoEm      DateTime?
  aprovadoPorId   String?
  aprovadoPor     User?     @relation("AprovadorLancamento", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoPorNome String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tenantId, aprovadoEm])
  @@index([tenantId, tipo, vencimento])
  @@index([tenantId, pagoEm, vencimento])
  @@index([tenantId, grupo])
  @@index([tenantId, clienteId])
  @@map("lancamentos")
}

/// UM COMPROMISSO DA CASA — a única coisa do Calendário que não é consequência
/// de outra.
///
/// As cinco fontes que o Calendário já juntava nascem de outro lugar: a parada
/// vem de uma ordem, a preventiva vem de um contrato, o vencimento vem de um
/// lançamento. Nenhuma delas se marca direto num dia.
///
/// Só que o dia de quem toca a assistência tem coisa que não é nenhuma das
/// cinco: "visitar a clínica antes de orçar", "reunião com o contador",
/// "treinamento do técnico no forno novo". Sem esta tabela o Calendário só
/// espelhava as outras telas, e não deixava marcar nada.
///
/// É DA EMPRESA, e não de cada um: uma agenda privada responderia "o que EU
/// tenho hoje" e perderia a pergunta que o Calendário existe para responder —
/// "o que a EQUIPE tem essa semana". Numa assistência de sete pessoas, é a
/// segunda que evita mandar dois técnicos para o mesmo lado.
model Compromisso {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  titulo String

  /// O DIA, sem hora e sem fuso — `@db.Date` de propósito.
  ///
  /// As outras fontes guardam instante porque o instante importa (a parada tem
  /// hora marcada, o vencimento tem fuso). Um compromisso é do dia: guardar
  /// `timestamp` traria de volta o evento do dia 12 aparecendo no 11 para quem
  /// abre a tela de outro fuso.
  dia DateTime @db.Date

  /// 'HH:MM' ou nulo — "quinta de manhã" é um compromisso legítimo e não tem
  /// hora. Texto, e não `time`, porque só é exibido e ordenado: 'HH:MM' ordena
  /// igual em texto e em relógio.
  hora String?

  /// Quem vai. OPCIONAL de propósito: metade dos compromissos de uma empresa
  /// pequena não tem dono ("entrega do fornecedor chega dia 12"), e obrigar um
  /// nome faria alguém escolher um qualquer só para o formulário salvar.
  responsavelId String?
  responsavel   User?   @relation("ResponsavelCompromisso", fields: [responsavelId], references: [id], onDelete: SetNull)

  observacao String?

  /// Resolvido. O compromisso NÃO é apagado quando cumprido: a agenda de trás é
  /// o que responde "quando foi mesmo que estivemos lá".
  concluido Boolean @default(false)

  /// O id some se a pessoa for removida; o nome fica, e é ele que a tela mostra.
  autorId   String?
  autorNome String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tenantId, dia])
  @@index([tenantId, responsavelId, dia])
  @@map("compromissos")
}

/// O MOLDE DE UM DOCUMENTO — escrito pela empresa, não pelo programador.
///
/// Contrato de prestação e nota promissória nasceram com o texto dentro do
/// código. Funciona para um molde e só um: a cláusula de foro é a de Lajeado, o
/// prazo é o que ficou escrito, e mudar uma vírgula é mexer no sistema.
///
/// Uma assistência que atende hospital, clínica e órgão público não tem UM
/// contrato — tem o do particular, o do convênio, o que o setor de compras
/// exige. E uma franquia nova terá os dela, com outro foro.
///
/// O corpo é texto corrido com `{{marcador}}` no meio da frase, porque contrato
/// não é formulário. O que acontece com marcador desconhecido está em
/// `src/server/documentos/variaveis.ts`, e é a decisão mais importante deste
/// desenho: ele NÃO é apagado, sai impresso — um documento com
/// `{{cliente_nomee}}` na folha é notado; um com um buraco no lugar do nome é
/// assinado.
model ModeloDocumento {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Como a pessoa chama este molde: "Contrato hospital", "Promissória 30 dias".
  nome String

  /// CONTRATO_PRESTACAO | NOTA_PROMISSORIA | ORDEM_SERVICO.
  ///
  /// Texto, e não o enum `TipoDocumento`, de propósito: aquele é o que a ESTEIRA
  /// emite — dez valores disparados por fatos. Aqui é o que se pode MODELAR à
  /// mão, e são três. Amarrar os dois faria a lista oferecer "comprovante de
  /// retirada", que nasce sozinho e ninguém escreve. A trava é um CHECK no
  /// banco, não só na tela.
  tipo String

  corpo     String
  descricao String?

  /// O molde usado quando ninguém escolhe. UM por tipo, garantido por índice
  /// único parcial no banco — sem ele, dois cliques rápidos deixariam dois
  /// padrões e a emissão escolheria um por acaso.
  padrao Boolean @default(false)

  /// Aposentar sem apagar: documento já emitido aponta para o molde, e "com que
  /// texto isto foi assinado?" precisa de resposta.
  ativo Boolean @default(true)

  autorId   String?
  autorNome String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tenantId, tipo, ativo])
  @@map("modelos_documento")
}

/// O que se repete todo mês: aluguel, energia, contador, o contrato de
/// manutenção que o cliente paga mensalmente.
///
/// É um MODELO, não um lançamento. Não aparece no caixa: ele GERA a linha do
/// mês, e a linha gerada é comum como qualquer outra — dá para corrigir o valor
/// daquele mês (a conta de luz nunca vem igual) sem mexer no modelo.
///
/// `ultimoMesGerado` é o que torna a geração IDEMPOTENTE. Apertar "gerar agora"
/// duas vezes no mesmo mês não pode criar a conta duas vezes — e é exatamente o
/// que alguém faz quando a tela demora a responder.
model Recorrencia {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo     TipoLancamento

  descricao     String
  categoria     String?
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  contraparte   String?
  valorCentavos Int

  /// Dia do mês em que vence. Fevereiro e os meses de 30 dias são resolvidos na
  /// geração, empurrando para o último dia do mês — nunca para o mês seguinte,
  /// porque uma conta que vence dia 31 vence NAQUELE mês.
  diaVencimento Int

  ativo  Boolean   @default(true)
  inicio DateTime  @default(now())
  fim    DateTime?

  /// 'AAAA-MM' do mês mais recente já gerado. SÓ PARA MOSTRAR NA TELA.
  ///
  /// Ele já foi o critério da geração, e estava errado: gerado agosto, julho
  /// ficava inalcançável para sempre, porque '2026-08' não é menor que
  /// '2026-07'. Quem começasse a usar o sistema em agosto nunca conseguiria
  /// lançar as contas de julho — e a tela ainda dizia "tudo gerado".
  ///
  /// Quem decide agora é a existência da conta no mês. Este campo sobrou como
  /// informação ("última conta gerada: 2026-08"), e sobe só quando o mês
  /// gerado é mais recente que o que estava aqui.
  ultimoMesGerado String?

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  gerados Lancamento[]

  @@index([tenantId, ativo])
  @@map("recorrencias")
}

/// Pedido de recuperação de senha.
///
/// Guarda o SHA-256 do token do link, nunca o token. Mesma decisão do cookie de
/// sessão, e pelo mesmo motivo: um backup vazado não pode virar um link que
/// troca a senha de alguém.
///
/// Nenhuma tela lê esta tabela. Ela é escrita e consumida por duas funções
/// `SECURITY DEFINER` do banco — quem pede está deslogado, sem empresa no
/// contexto, e o RLS devolveria zero linhas para qualquer consulta normal.
model RecuperacaoSenha {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Repetido de propósito: as funções do banco precisam saber a empresa sem
  /// atravessar `usuarios`, que está sob FORCE ROW LEVEL SECURITY.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  tokenHash String    @unique
  expiraEm  DateTime
  /// Preenchido quando o link é gasto — ou quando um pedido novo o substitui.
  usadoEm   DateTime?
  ip        String?
  criadoEm  DateTime  @default(now())

  @@index([userId, criadoEm])
  @@index([expiraEm])
  @@map("recuperacoes_senha")
}

/// Numeração sequencial por empresa e por documento, sem sequence global.
/// Incrementada com bloqueio de linha dentro da transação.
model Contador {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "ordem" | "orcamento" | "fatura"
  chave    String
  valor    Int    @default(0)

  @@id([tenantId, chave])
  @@map("contadores")
}

/// ---------------------------------------------------------------------------
/// CONTEÚDO DO SITE
/// ---------------------------------------------------------------------------
/// O texto e as escolhas do site institucional, editáveis pelo painel do Super
/// Admin em vez de por alteração de código.
///
/// Uma LINHA SÓ, de id fixo. O site é um: o da matriz. Não é conteúdo de
/// franquia — se fosse, teria `tenantId` e cada uma editaria o seu. Fixar o id
/// é o que impede duas linhas concorrentes existirem e ninguém saber qual vale.
///
/// O conteúdo vai em `Json` e não em cinquenta colunas porque ele MUDA de forma:
/// hoje são seis serviços, amanhã são oito, depois entra uma seção nova. Cada
/// mudança dessas viraria uma migração de banco. A forma é garantida na
/// entrada, por um esquema de validação, e não pelo formato da tabela.
model ConteudoSite {
  id    String @id @default("site")
  dados Json

  /// Sobe a cada gravação. É o que a tela de edição usa para perceber que
  /// alguém salvou por cima enquanto ela estava aberta.
  versao Int @default(1)

  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String?

  historico ConteudoSiteVersao[]

  @@map("conteudo_site")
}

/// Cada gravação vira uma linha aqui, ANTES de o conteúdo novo entrar.
///
/// Sem isto, um deslize na tela de edição apaga o texto do site e não há como
/// voltar: o conteúdo anterior não existe em lugar nenhum. Com isto, voltar é
/// escolher uma linha e apertar um botão.
model ConteudoSiteVersao {
  id     String       @id @default(cuid())
  siteId String
  site   ConteudoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  versao    Int
  dados     Json
  /// Quem gravou, e o que ele escreveu como motivo (opcional).
  autorId   String?
  autorNome String?
  nota      String?

  criadoEm DateTime @default(now())

  @@index([siteId, versao])
  @@map("conteudo_site_versoes")
}

/// A posição do motorista DURANTE a rota.
///
/// -----------------------------------------------------------------------------
/// POR QUE SÓ DURANTE A ROTA
/// -----------------------------------------------------------------------------
/// A pergunta que a central precisa responder é "onde está o aparelho do cliente
/// agora" — e ela só existe entre o motorista sair e chegar. Fora disso, guardar
/// a localização de alguém deixa de ser logística e vira monitoramento de
/// funcionário: outra finalidade, outra base legal, outra conversa.
///
/// Por isso a linha se pendura no AGENDAMENTO, e não no usuário. Sem parada em
/// rota, não há onde gravar — a trava é a forma da tabela, não uma regra que
/// alguém precisa lembrar de aplicar.
///
/// -----------------------------------------------------------------------------
/// POR QUE NÃO É PROVA, E POR ISSO PODE SUMIR
/// -----------------------------------------------------------------------------
/// A prova da entrega é a assinatura, com a coordenada dela — essa fica para
/// sempre. Isto aqui é o rastro do caminho, que serve enquanto o caminho está
/// acontecendo. Guardar meses de deslocamento minuto a minuto seria acumular
/// risco sem ganhar nada: `scripts/limpar-rastros.mts` apaga o que passou.
model PosicaoRota {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agendamentoId String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  /// Quem estava dirigindo. Fica desnormalizado para a tela não precisar de
  /// mais um salto, e porque o motorista da parada pode ser trocado depois.
  motoristaId   String
  motoristaNome String

  latitude   Float
  longitude  Float
  /// Raio de erro em metros, como o aparelho informou. Uma posição de 2 km de
  /// precisão não é uma posição — a tela precisa saber para não mentir.
  precisaoM  Float?
  /// Velocidade em m/s, quando o aparelho informa. Distingue parado de andando.
  velocidade Float?

  criadoEm DateTime @default(now())

  @@index([tenantId, agendamentoId, criadoEm])
  @@index([tenantId, criadoEm])
  @@map("posicoes_rota")
}

/// Configuração da PLATAFORMA — o que é do dono do SaaS, não de uma franquia.
///
/// ---------------------------------------------------------------------------
/// POR QUE ISTO SAIU DA VARIÁVEL DE AMBIENTE
/// ---------------------------------------------------------------------------
/// O endereço e o token de administração da uazapi viviam em `UAZAPI_BASE_URL`
/// e `UAZAPI_ADMIN_TOKEN`. Funciona para um sistema de uma empresa, e trava
/// para um SaaS: trocar o token — porque venceu, porque vazou, porque mudou de
/// provedor — obrigava a entrar na VPS, editar arquivo e subir o contêiner de
/// novo. Configuração que só o servidor sabe mudar é configuração que na
/// prática ninguém muda.
///
/// Aqui é chave e valor porque o conjunto vai crescer — hoje são dois campos do
/// WhatsApp, amanhã entra o gateway de cobrança. Uma coluna por item viraria
/// uma migração de banco por item.
///
/// ---------------------------------------------------------------------------
/// QUEM PODE LER
/// ---------------------------------------------------------------------------
/// A tabela não tem `tenantId` de propósito: ela não pertence a franquia
/// nenhuma. O RLS a fecha para todo mundo e a abre em dois casos, escritos na
/// migração: o dono da plataforma, e a janela estreita que o próprio servidor
/// abre para falar com a uazapi. Nenhum usuário de franquia lê uma linha daqui,
/// nem por engano de consulta.
///
/// Valor sensível entra CIFRADO (o mesmo `cifrar` do token de instância), e
/// `sigiloso` marca quais são — é o que a tela usa para nunca devolver o
/// conteúdo ao navegador, mostrando só "configurado" ou "vazio".
model ConfigPlataforma {
  chave String @id

  valor    String
  sigiloso Boolean @default(false)

  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String?

  @@map("config_plataforma")
}
